BENCH_URL=http://localhost:8080
BENCH_USERS=testuser1,testuser2,bhargav,saksham,bhargavmane
BENCH_PASSWORD=set a password

# Optional tuning (shared by benchmark.js and message-benchmark.js)
BENCH_STAGE_MS=60000
BENCH_MESSAGE_INTERVAL_MS=2000
BENCH_ACK_TIMEOUT_MS=10000
BENCH_CONNECT_TIMEOUT_MS=12000
BENCH_CONNECT_BATCH_SIZE=25
BENCH_OUTPUT_DIR=./benchmark-results

# Optional tuning for message-benchmark.js (all message.controller routes)
BENCH_STAGES=5,20,50,100,250
BENCH_SCENARIOS=shared-room,single-room
BENCH_SINGLE_ROOM_MODE=per-account
BENCH_ROUTES=create,display,update,read,delete,mixed
BENCH_ROUTE_STAGE_MS=20000
BENCH_OP_INTERVAL_MS=1000
BENCH_AUTH_MODE=login
BENCH_SEED_MESSAGES=60
BENCH_DISPLAY_LIMIT=60
BENCH_MIXED_WEIGHTS=create:35,display:30,read:15,update:12,delete:8
BENCH_CLEANUP_ROOMS=false
BENCH_SERVER_METRICS=true
BENCH_METRICS_URL=http://localhost:8080/__bench/metrics
